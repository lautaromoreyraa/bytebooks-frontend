# Copia de referencia de las variables que lee el frontend.
# El archivo real es .env, que no se versiona.

# Origen de la API. En desarrollo, la que levanta ./mvnw spring-boot:run.
VITE_API_URL=http://localhost:8080

# Origen publico del sitio, SIN barra final. Lo usan las etiquetas og: de
# index.html, que exigen una URL absoluta: con una ruta relativa la tarjeta
# viaja sin imagen. En el despliegue va el dominio real.
VITE_SITE_URL=http://localhost:5173

# Las imagenes se suben a Cloudinary con una firma que emite la API
# (POST /imagenes/firma): la cuenta y sus credenciales se configuran en el
# backend, no aca.
